{
  "name": "allay-backend",
  "pnpm": {},
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --minify",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome check src/",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bun run drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bun test src/__tests__/integration/",
    "db:studio": "bun run drizzle-kit studio",
    "db:reset": "bun run drizzle-kit drop && bun run drizzle-kit push"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.48",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.27",
    "jose": "^6.2.2",
    "node-cron": "^3.0.3",
    "pidusage": "^3.0.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "prismarine-nbt": "^2.8.0",
    "sharp": "^0.34.5",
    "tar": "^7.5.9",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.3",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pidusage": "^2.0.5",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^2.10.3",
    "bun-types": "^1.3.12",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
