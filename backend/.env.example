# Allay (Elixir/Phoenix) runtime environment.
#
# config/runtime.exs loads `.env` via Dotenvy for dev and prod (NOT test, which
# is driven entirely by config/test.exs). Every var has a default in
# runtime.exs, so `.env` is optional for native `mix phx.server` dev. Real
# environment variables always take precedence over this file.
#
# Native dev:  copy to `.env` (gitignored), keep DATABASE_URL on localhost.
# Release/image: the image ships no `.env`; pass these as real env vars, e.g.
#   docker run --env-file backend/.env -p 4000:4000 allay-ex:test
#   (in a container, point DATABASE_URL at host.docker.internal, not localhost)

# Postgres connection. The release migrates on boot but does NOT create the DB.
DATABASE_URL=ecto://allay:allay@localhost:5432/allay_dev

# Phoenix signing secret. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# HTTP port — the SPA, REST API and the /socket WebSocket all share it.
PORT=4000

# Where server directories, JAR cache, backups and import temp live.
DATA_DIR=data

# Minecraft port range offered to new servers.
MC_PORT_MIN=25565
MC_PORT_MAX=25575

# Release only: start the HTTP server (dev's `mix phx.server` sets this itself).
# PHX_SERVER=true

# Set ONLY behind a reverse proxy on a different origin than the backend.
# Drives the canonical URL host and the WebSocket check_origin allowlist.
# ALLAY_PUBLIC_ORIGIN=https://allay.example.com
