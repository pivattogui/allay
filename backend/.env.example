# Allay (Elixir/Phoenix) runtime environment.
#
# config/runtime.exs loads `.env` via Dotenvy for dev and prod (NOT test, which
# is driven entirely by config/test.exs). Native development has safe defaults;
# production requires DATABASE_URL, SECRET_KEY_BASE and FRONTEND_ORIGIN. Real
# environment variables always take precedence over this file.
#
# Native dev:  copy to `.env` (gitignored), keep DATABASE_URL on localhost.
# Release/image: the image ships no `.env`; pass these as real env vars, e.g.
#   docker run --env-file backend/.env -p 4000:4000 allay-backend
#   (in a container, point DATABASE_URL at host.docker.internal, not localhost)

# Postgres connection. The release migrates on boot but does NOT create the DB.
DATABASE_URL=ecto://allay:allay@localhost:5432/allay_dev

# Database connection pool size.
POOL_SIZE=10

# Enable IPv6 sockets for PostgreSQL when required by the deployment network.
# ECTO_IPV6=false

# Phoenix signing secret. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# HTTP port for the REST API, health endpoint and /socket WebSocket.
PORT=4000

# Public frontend origin allowed by CORS and Phoenix Channels.
FRONTEND_ORIGIN=http://localhost:5173

# Where server directories, JAR cache, backups and import temp live.
DATA_DIR=data

# Minecraft port range offered to new servers.
MC_PORT_MIN=25565
MC_PORT_MAX=25575

# Release only: start the HTTP server (dev's `mix phx.server` sets this itself).
# PHX_SERVER=true

# JDK install roots scanned for available Java majors (colon-separated). The
# release image uses the Linux defaults (/opt/java:/usr/lib/jvm). On native dev
# point this at where your JDKs live, e.g. the asdf root:
# JAVA_SCAN_DIRS=/Users/you/.asdf/installs/java

# Public backend URL used to derive Phoenix's canonical host.
# ALLAY_PUBLIC_ORIGIN=https://api.allay.example.com

# Optional DNS query used to discover clustered backend nodes.
# DNS_CLUSTER_QUERY=
