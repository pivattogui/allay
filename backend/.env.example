# Ambiente
NODE_ENV=development
PORT=3000

# Dados
DATA_DIR=./data

# Database (PostgreSQL)
DATABASE_URL=postgresql://allay:allay@localhost:5432/allay

# JWT (OBRIGATORIO em producao - minimo 16 caracteres)
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# Token compartilhado entre controller e agent (OBRIGATORIO)
AGENT_TOKEN=change-this-to-a-secure-random-string

# Java (opcional - usado para detectar versao do Java)
# JAVA_HOME=/usr/lib/jvm/java-21
