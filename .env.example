# --- Required ---
# Strong secret (min 16 chars). Generate with: openssl rand -hex 32
JWT_SECRET=
# PostgreSQL password (used by both Allay and the bundled postgres service)
DB_PASSWORD=

# --- Image version ---
# Pin a specific release for stability: "1.2.3" or "1.2" or "main-abc1234"
ALLAY_VERSION=latest

# --- Network ---
# Host port for the web UI (frontend + API + WS, all on the same port)
ALLAY_PORT=8080
# Port range exposed to Minecraft players (TCP). Adjust if you need more servers.
MC_PORT_MIN=25565
MC_PORT_MAX=25575

# --- Database (override only if using external Postgres) ---
DB_USER=allay
DB_NAME=allay
# Full connection string. Overrides the bundled postgres if set explicitly.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth ---
JWT_EXPIRES_IN=24h

# --- Public origin (CORS) ---
# Set ONLY if you put Allay behind a reverse proxy with a public hostname
# AND access the UI from a different origin than the backend.
# Leave empty for same-origin setups (the default).
# Example: ALLAY_PUBLIC_ORIGIN=https://allay.example.com
ALLAY_PUBLIC_ORIGIN=

# --- Logging ---
LOG_LEVEL=info
