# --- Required ---
# Phoenix signing secret. Generate with: docker run --rm ghcr.io/pivattogui/allay bin/allay eval "IO.puts(Base.encode64(:crypto.strong_rand_bytes(48)))"
# or, with Elixir installed: mix phx.gen.secret
SECRET_KEY_BASE=
# PostgreSQL password (used by both Allay and the bundled postgres service)
DB_PASSWORD=

# --- Image version ---
# Pin a specific release for stability: "1.2.3" or "1.2" or "main-abc1234"
ALLAY_VERSION=latest

# --- Network ---
# Host port for the web UI (frontend + API + WebSocket, all on the same port).
# Maps to the container's port 4000.
ALLAY_PORT=8080
# Port range exposed to Minecraft players (TCP). Adjust if you need more servers.
MC_PORT_MIN=25565
MC_PORT_MAX=25575

# --- Database (override only if using external Postgres) ---
DB_USER=allay
DB_NAME=allay
# Full connection string. Overrides the bundled postgres if set explicitly.
# DATABASE_URL=ecto://user:pass@host:5432/dbname

# --- Public origin ---
# Set ONLY if you put Allay behind a reverse proxy with a public hostname AND
# access the UI from a different origin than the backend. Drives the canonical
# URL host and the WebSocket check_origin allowlist. Leave empty for same-origin.
# Example: ALLAY_PUBLIC_ORIGIN=https://allay.example.com
ALLAY_PUBLIC_ORIGIN=
