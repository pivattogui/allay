# ============================================
# Allay - Environment Variables
# ============================================
# Copy this file to .env and adjust values.
#
# Development: defaults work without changes.
# Production: DB_PASSWORD and JWT_SECRET are REQUIRED.

# --- Database ---
DB_USER=allay
DB_PASSWORD=allay
DB_NAME=allay
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=development-secret-change-in-production
JWT_EXPIRES_IN=24h

# --- Frontend ---
FRONTEND_PORT=5173

# --- Production (generate secure values) ---
# JWT_SECRET=$(openssl rand -base64 32)
# DB_PASSWORD=$(openssl rand -base64 24)
