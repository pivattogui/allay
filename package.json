{
  "name": "allay",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "db": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:stop": "docker compose -f docker-compose.dev.yml stop postgres",
    "dev:frontend": "pnpm -F allay-frontend dev",
    "build": "pnpm -F allay-frontend build",
    "lint": "biome ci .",
    "format": "biome format --write . && biome check --fix .",
    "test:frontend": "pnpm -F allay-frontend test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "concurrently": "^9.1.2"
  }
}
